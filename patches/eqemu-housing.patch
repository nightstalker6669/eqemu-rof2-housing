+    if(!changed.Success()||changed.RowsAffected()!=1)return rollback(GuidLoadResult::DatabaseFailure);
+   }
+   committing=true;
+   if(!db.QueryDatabase(std::string("COMMIT"),false).Success())return GuidLoadResult::CommitUncertain;
